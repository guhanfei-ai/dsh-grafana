{
  "name": "dsh-grafana",
  "version": "0.17.1",
  "description": "Conversational Grafana operations for DeepSeek Harness: inspect live observability data and make safe, reviewable dashboard changes",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check scripts/identifier-check.js && find lib -name '*.js' -exec node --check {} \\; && find test -name '*.test.js' -exec node --check {} \\;",
    "check:identifiers": "node scripts/identifier-check.js --repository",
    "test": "node --test",
    "verify": "npm run check && npm test && npm run check:identifiers",
    "prepack": "npm run verify"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "optionalDependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.0 || ^0.1.2-alpha.0 || ^0.1.3-alpha.0 || ^0.1.5-alpha.0 || ^0.1.7-alpha.0 || ^0.2.0-alpha.0 || ^0.2.1-alpha.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "deepseek",
    "harness",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "grafana",
    "dashboard",
    "observability",
    "metrics",
    "prometheus",
    "promql",
    "loki",
    "logql",
    "alerting"
  ],
  "author": "guhanfei-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guhanfei-ai/dsh-grafana.git"
  },
  "homepage": "https://github.com/guhanfei-ai/dsh-grafana#readme",
  "bugs": {
    "url": "https://github.com/guhanfei-ai/dsh-grafana/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}
